{
  "name": "nd-camera",
  "private": true,
  "version": "0.1.0",
  "main": "index.js",
  "description": "ND Camera photo companion, initialized from Universal Apps.",
  "engines": {
    "node": ">=22.16.0"
  },
  "scripts": {
    "start": "expo start --dev-client",
    "dev": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "check:starter": "node scripts/check-starter.mjs",
    "check:expo": "expo install --check",
    "check": "npm run check:starter && npm test && npm run typecheck",
    "export:android": "expo export --platform android --output-dir .checks/android"
  },
  "dependencies": {
    "expo": "57.0.28",
    "expo-crypto": "57.0.4",
    "expo-dev-client": "57.0.20",
    "expo-file-system": "57.0.7",
    "expo-image-picker": "57.0.20",
    "expo-sharing": "57.0.23",
    "@expo/metro-runtime": "57.0.16",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-web": "~0.21.0",
    "uniwind": "1.11.0"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "babel-preset-expo": "~57.0.0",
    "tailwindcss": "4.3.0",
    "typescript": "~6.0.3"
  }
}
